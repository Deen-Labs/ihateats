@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

@import "tailwindcss";

/* ═══════════════════════════════════════════════════════
   DESIGN SYSTEM — "Midnight Amethyst"
   ═══════════════════════════════════════════════════════ */

:root {
  --bg-deep: #0a0a0f;
  --bg-surface: #12121a;
  --bg-elevated: #1a1a2e;
  --accent-violet: #7c3aed;
  --accent-cyan: #06b6d4;
  --accent-lavender: #a78bfa;
  --accent-emerald: #10b981;
  --accent-coral: #f97316;
  --text-primary: #ffffff;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --border-glass: rgba(255, 255, 255, 0.07);
  --border-hover: rgba(6, 182, 212, 0.3);
  --glow-violet: rgba(124, 58, 237, 0.15);
  --glow-cyan: rgba(6, 182, 212, 0.15);
  --glow-emerald: rgba(16, 185, 129, 0.15);
}

/* ═══════════════════════════════════════════════════════
   BASE
   ═══════════════════════════════════════════════════════ */

html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
}

body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transform: translateZ(0); /* Force GPU Layering for 120Hz/60Hz VSync Render */
}

/* ═══════════════════════════════════════════════════════
   SCROLLBAR
   ═══════════════════════════════════════════════════════ */

::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(124, 58, 237, 0.3);
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(124, 58, 237, 0.5);
}

/* ═══════════════════════════════════════════════════════
   GLASS CARD
   ═══════════════════════════════════════════════════════ */

.glass-card {
  background: rgba(18, 18, 26, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-glass);
  border-radius: 1rem;
}

.glass-card-elevated {
  background: rgba(26, 26, 46, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-glass);
  border-radius: 0.75rem;
}

/* ═══════════════════════════════════════════════════════
   INPUTS
   ═══════════════════════════════════════════════════════ */

.input-dark {
  background: var(--bg-deep);
  border: 1px solid var(--border-glass);
  border-radius: 0.5rem;
  color: var(--text-primary);
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  padding: 0.625rem 0.875rem;
  transition: border-color 0.2s, box-shadow 0.2s;
  width: 100%;
  outline: none;
}

.input-dark:focus {
  border-color: var(--accent-violet);
  box-shadow: 0 0 0 3px var(--glow-violet);
}

.input-dark::placeholder {
  color: var(--text-muted);
}

textarea.input-dark {
  resize: vertical;
  line-height: 1.65;
  min-height: 80px;
}

/* ═══════════════════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════════════════ */

.btn-primary {
  background: linear-gradient(135deg, var(--accent-violet), #6d28d9);
  color: white;
  border: none;
  border-radius: 0.5rem;
  padding: 0.75rem 1.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 2px 12px rgba(124, 58, 237, 0.3);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 20px rgba(124, 58, 237, 0.45);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.btn-secondary {
  background: transparent;
  color: var(--accent-lavender);
  border: 1px solid rgba(167, 139, 250, 0.2);
  border-radius: 0.5rem;
  padding: 0.625rem 1.25rem;
  font-size: 0.8125rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-secondary:hover {
  background: rgba(124, 58, 237, 0.1);
  border-color: var(--accent-lavender);
}

.btn-emerald {
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
  border: none;
  border-radius: 0.5rem;
  padding: 0.75rem 1.5rem;
  font-size: 0.875rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 2px 12px rgba(16, 185, 129, 0.3);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-emerald:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 20px rgba(16, 185, 129, 0.45);
}

/* ═══════════════════════════════════════════════════════
   ANIMATED COUNTER
   ═══════════════════════════════════════════════════════ */

@keyframes countUp {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-count-up {
  animation: countUp 0.5s ease-out forwards;
}

/* ═══════════════════════════════════════════════════════
   TAB PILLS
   ═══════════════════════════════════════════════════════ */

.tab-pill {
  padding: 0.5rem 1rem;
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
  border: 1px solid transparent;
  color: var(--text-secondary);
  background: transparent;
}

.tab-pill:hover {
  color: var(--text-primary);
  background: rgba(124, 58, 237, 0.1);
}

.tab-pill-active {
  background: var(--accent-violet) !important;
  color: white !important;
  border-color: var(--accent-violet) !important;
  box-shadow: 0 2px 12px rgba(124, 58, 237, 0.3);
}

/* ═══════════════════════════════════════════════════════
   PRINT STYLES (for PDF export)
   ═══════════════════════════════════════════════════════ */

@media print {
  body * {
    visibility: hidden;
  }
  #resume-print-target,
  #resume-print-target * {
    visibility: visible;
  }
  #resume-print-target {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    background: white !important;
    color: black !important;
    font-size: 10pt;
    padding: 0;
    margin: 0;
  }
  @page {
    size: letter;
    margin: 0.5in 0.6in;
  }
}

/* ═══════════════════════════════════════════════════════
   RESUME DOCUMENT STYLES (LaTeX replica)
   ═══════════════════════════════════════════════════════ */

.resume-document {
  font-family: Georgia, 'Times New Roman', 'Computer Modern', serif;
  color: #000000;
  background: #ffffff;
  font-size: 10pt;
  line-height: 1.3;
  padding: 0.5in 0.6in;
  width: 8.5in;
  min-height: 11in;
  box-sizing: border-box;
}

.resume-document h1 {
  font-variant: small-caps;
  font-weight: 700;
  font-size: 22pt;
  text-align: center;
  margin: 0 0 4pt 0;
  letter-spacing: 0.5pt;
}

.resume-document .contact-line {
  text-align: center;
  font-size: 9pt;
  margin-bottom: 6pt;
  color: #333;
}

.resume-document .contact-line a {
  color: #333;
  text-decoration: none;
}

.resume-document .section-title {
  font-variant: small-caps;
  font-weight: 700;
  font-size: 12pt;
  border-bottom: 1px solid #000;
  padding-bottom: 2pt;
  margin: 10pt 0 4pt 0;
}

.resume-document .subheading {
  display: flex;
  justify-content: space-between;
  margin: 4pt 0 1pt 0;
}

.resume-document .subheading-title {
  font-weight: 700;
  font-size: 10pt;
}

.resume-document .subheading-date {
  font-weight: 700;
  font-size: 9pt;
}

.resume-document .subheading-subtitle {
  display: flex;
  justify-content: space-between;
  font-style: italic;
  font-size: 9pt;
  margin-bottom: 2pt;
  color: #444;
}

.resume-document ul {
  margin: 2pt 0 4pt 0;
  padding-left: 16pt;
}

.resume-document ul li {
  font-size: 9.5pt;
  margin-bottom: 1pt;
  line-height: 1.35;
}

.resume-document .skills-table {
  width: 100%;
  font-size: 9.5pt;
  border-collapse: collapse;
}

.resume-document .skills-table td {
  padding: 1pt 0;
  vertical-align: top;
}

.resume-document .skills-table td:first-child {
  width: 1.6in;
  font-weight: 700;
}

/* ═══════════════════════════════════════════════════════
   LOADING SPINNER
   ═══════════════════════════════════════════════════════ */

@keyframes spin {
  to { transform: rotate(360deg); }
}

.spinner {
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

/* ═══════════════════════════════════════════════════════
   GRADIENT TEXT
   ═══════════════════════════════════════════════════════ */

.gradient-text-violet {
  background: linear-gradient(135deg, #a78bfa, #7c3aed, #c4b5fd);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.gradient-text-cyan-violet {
  background: linear-gradient(135deg, #06b6d4, #7c3aed, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.section-focus-ring {
  ring: 2px;
  ring-color: #06b6d4;
  box-shadow: 0 0 20px rgba(6, 182, 212, 0.35);
  transition: all 0.3s ease-in-out;
}

/* ═══════════════════════════════════════════════════════
   PULSE GLOW
   ═══════════════════════════════════════════════════════ */

@keyframes pulseGlow {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.pulse-glow {
  animation: pulseGlow 2s ease-in-out infinite;
}

/* ═══════════════════════════════════════════════════════
   PRINT STYLES (PDF EXPORT)
   ═══════════════════════════════════════════════════════ */

@media print {
  @page {
    size: auto;
    margin: 0 !important;
  }

  html, body {
    background: #ffffff !important;
    color: #000000 !important;
    margin: 0 !important;
    padding: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
  }

  /* Completely erase all web layout elements from the print tree */
  body.printing-resume > *:not(#dedicated-print-container) {
    display: none !important;
  }

  /* Show ONLY the isolated print container */
  #dedicated-print-container {
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #ffffff !important;
    break-after: avoid !important;
    page-break-after: avoid !important;
  }

  #dedicated-print-container #resume-print-target {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    box-shadow: none !important;
    border: none !important;
    background: #ffffff !important;
    transform: none !important;
    position: static !important;
  }

  /* Prevent mid-item page splits across projects, experience, and headers */
  .resume-section-item,
  .resume-experience-item,
  .resume-project-item,
  .resume-education-item {
    break-inside: avoid !important;
    page-break-inside: avoid !important;
  }

  .resume-section-header {
    break-after: avoid !important;
    page-break-after: avoid !important;
  }
}
