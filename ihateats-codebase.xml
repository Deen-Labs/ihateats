                >
                  {plan.badge && (
                    <span className="absolute -top-3 left-1/2 -translate-x-1/2 px-2.5 py-0.5 rounded-full bg-gradient-to-r from-[#06b6d4] to-[#7c3aed] text-[10px] font-extrabold uppercase text-white shadow-sm whitespace-nowrap">
                      {plan.badge}
